# Скопіюйте цей файл у .env. Ключ доступу — той самий, що в ПР3–ПР4:
# перенесіть його з тамтешнього .env. Налаштування ембедінгів — ті самі,
# що в ПР5: якщо ви їх змінювали, перенесіть і їх, інакше індекс, збудований
# тут, відрізнятиметься від того, який ви перевіряли.
# Файл .env до репозиторію не потрапляє — ключ доступу є секретом.

# ---- Мовна модель (як у ПР3–ПР4) ----

# Адреса OpenAI-сумісного ендпоінта Gemini. Змінювати не потрібно.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Ключ із Google AI Studio: https://aistudio.google.com → Get API key
LLM_API_KEY=

# Назва моделі. Перелік доступних дивіться в Google AI Studio.
LLM_MODEL=gemini-3.8-flash

# Параметри генерації. Відповідь за документами не має бути творчою —
# температура низька. Запас max_tokens — на текст відповіді, посилання
# на джерела й службові поля.
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=700

# Скільки секунд чекати на відповідь, перш ніж перервати запит.
LLM_TIMEOUT=30

# ---- Ембедінги й індекс (як у ПР5) ----

# Модель ембедінгів. Змінивши модель, перебудуйте індекс.
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Параметри поділу на фрагменти — ті, що ви обрали в ПР5.
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# Скільки влучень повертає пошук і нижче якої схожості вони відкидаються.
# Поріг ви вивели в ПР5 з власних запитів — перенесіть його сюди: тут він
# вирішує, чи взагалі звертатися до моделі.
SEARCH_TOP_K=8
SIMILARITY_THRESHOLD=

# ---- Збирання контексту для моделі (нове) ----

# Скільки фрагментів іде в контекст моделі. Не те саме, що SEARCH_TOP_K:
# шукати можна ширше, а віддавати моделі — менше і лише найкраще.
RAG_CONTEXT_CHUNKS=4

# Бюджет токенів на контекст — без інструкції й питання. Чим його
# рахувати, ви вирішили в ПР4; що відкидати, коли фрагменти не вміщуються,
# вирішуєте тут.
RAG_CONTEXT_BUDGET=1500
