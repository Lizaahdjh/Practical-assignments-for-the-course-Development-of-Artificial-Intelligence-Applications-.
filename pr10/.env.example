# Скопіюйте цей файл у .env. Ключ доступу — той самий, що в ПР3–ПР9:
# перенесіть його з тамтешнього .env.
# Файл .env до репозиторію не потрапляє — ключ доступу є секретом.

# ---- Провайдер ----

# Хто відповідає на запити: `openai` — справжній OpenAI-сумісний API
# (нижче), `mock` — підставний провайдер з app/providers/mock.py, що
# працює без ключа й уміє збоїти на вимогу. Застосунок має запускатися
# з будь-яким значенням.
LLM_PROVIDER=openai

# Запасний варіант, якщо основний провайдер не впорався після всіх
# спроб: `none` — повернути помилку; `mock` — підставний провайдер;
# інша назва моделі — та сама адреса й ключ, інша модель.
LLM_FALLBACK=none

# ---- Мовна модель (як у ПР3–ПР9) ----

# Адреса OpenAI-сумісного ендпоінта Gemini. Змінювати не потрібно.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Ключ із Google AI Studio: https://aistudio.google.com → Get API key
LLM_API_KEY=

# Назва моделі.
LLM_MODEL=gemini-3.5-flash-lite

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=600

# ---- Надійність ----
# Значення — відправна точка. Свої обґрунтуйте вимірюванням: скільки
# триває звичайна чернетка, коли приходить перший фрагмент.

# Скільки секунд чекати на одну спробу (на зʼєднання і на відповідь).
LLM_TIMEOUT=20
# Скільки секунд у режимі streaming може не приходити жодного фрагмента.
LLM_IDLE_TIMEOUT=8
# Скільки секунд має весь запит разом з усіма спробами й паузами.
LLM_TOTAL_TIMEOUT=45
# Скільки спроб звернутися до провайдера, разом із першою.
LLM_MAX_ATTEMPTS=3
# Пауза перед повтором: базова і найбільша, секунд. Між спробами
# пауза зростає; до неї додається випадкова частка.
LLM_BACKOFF_BASE=0.5
LLM_BACKOFF_MAX=8
# Скільки звертань до провайдера може виконуватися одночасно — на весь
# застосунок, незалежно від того, хто просить.
LLM_MAX_CONCURRENT=2

# ---- Обмеження власного API ----

# Скільки чернеток за хвилину може замовити один клієнт сторінки.
RATE_LIMIT_PER_MINUTE=10

# ---- Підставний провайдер (mock) ----
# Діє лише коли LLM_PROVIDER=mock або LLM_FALLBACK=mock. Через ці
# налаштування відтворюють збої, не чекаючи на них від справжнього
# провайдера.

# Затримка перед першим фрагментом і між фрагментами, мілісекунд.
MOCK_FIRST_DELAY_MS=600
MOCK_DELAY_MS=40
# Частка звертань, що завершуються збоєм (від 0 до 1), і вид збою:
# timeout | rate_limit | unavailable | auth | mid_stream (обрив після
# кількох фрагментів).
MOCK_FAILURE_RATE=0
MOCK_FAILURE_KIND=unavailable
