# === Провайдер ===
# mock | openai_compat | local
LLM_PROVIDER=openai_compat
LLM_MODEL=gemini-1.5-flash
# Ключ потрібен лише коли LLM_PROVIDER != mock. У зразку — порожній.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_TIMEOUT_S=15

# === Бюджет (ПР15) ===
# 0.0 = без ліміту (для тестів)
BUDGET_DAILY_USD=0.0
# Для локальних моделей — ліміт кількості викликів
BUDGET_DAILY_CALLS=50

# === Підставний провайдер ===
MOCK_DELAY_MS=0
# 0.0 .. 1.0 — частка збоїв
MOCK_FAILURE_RATE=0.0
# timeout | rate_limit | unavailable | invalid_json | mid_stream
MOCK_FAILURE_KIND=timeout

# === Сховище ===
DB_PATH=data/app.db

# === Журнал ===
LOG_FILE=data/app.log

# === Застосунок ===
APP_VERSION=dev