# Скопіюйте цей файл у .env і впишіть свій ключ.
# Файл .env до репозиторію не потрапляє — ключ доступу є секретом.

# Адреса OpenAI-сумісного ендпоінта Gemini. Змінювати не потрібно.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Ключ із Google AI Studio: https://aistudio.google.com → Get API key
LLM_API_KEY=

# Назва моделі. Перелік доступних дивіться в Google AI Studio —
# назви змінюються з виходом нових версій.
LLM_MODEL=gemini-3.8-flash

# Параметри генерації. Саме їх ви змінюватимете під час порівняння.
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=500

# Скільки секунд чекати на відповідь, перш ніж перервати запит.
LLM_TIMEOUT=30
